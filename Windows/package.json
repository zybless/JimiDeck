{
  "name": "jimideck-windows",
  "version": "0.2.0",
  "description": "JimiDeck Codex instance manager for Windows",
  "main": "main.js",
  "author": "JimiDeck",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js && node --check renderer/app.js && node --test test/*.test.js",
    "dist:windows": "electron-builder --win nsis zip --x64"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.jimidou.JimiDeck",
    "productName": "JimiDeck",
    "asar": true,
    "files": [
      "main.js",
      "storage.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "../Release/UNSIGNED-NOTICE-Windows.txt",
        "to": "README-FIRST.txt"
      }
    ],
    "directories": {
      "output": "../dist/windows",
      "buildResources": "assets"
    },
    "win": {
      "icon": "assets/icon.ico",
      "artifactName": "JimiDeck-${version}-Alpha-Windows-${arch}.${ext}",
      "electronLanguages": [
        "en-US",
        "zh-CN"
      ],
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "JimiDeck"
    }
  }
}
